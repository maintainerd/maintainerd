# Core Console SPA — runtime configuration.
#
# THE VALUE IS OPTIONAL. In the release image the console is served same-origin
# by a proxy and this is injected at runtime via /config.js (window.__ENV__), so
# you do NOT rebuild to retarget the API. When unset, config.ts falls back to the
# same-origin path (/api/v1). In dev the maintainerd-dev nginx edge serves the
# console and proxies /api → core, so this stays empty.

# Absolute base URL for the core REST API (only for a split-host deploy).
VITE_CORE_API_BASE_URL=
