# Core Console SPA — runtime configuration.
#
# THE VALUES ARE OPTIONAL AND ARE READ AT RUN TIME. In the release image the
# console is served same-origin by a proxy and these are injected via /config.js
# (window.__ENV__), so you do NOT rebuild to retarget the API or the identity
# provider. The VITE_* names in this file are the build-time fallbacks a local
# .env uses.
#
# TWO SPELLINGS, ONE MEANING. At runtime the console prefers the SERVICE's own
# variable names, so an operator sets each value ONCE and both core and its
# console read it:
#
#   runtime (window.__ENV__)     build time (.env, this file)
#   --------------------------   ----------------------------------
#   VITE_CORE_API_BASE_URL       VITE_CORE_API_BASE_URL
#   AUTH_ISSUER                  VITE_OAUTH_ISSUER_URL
#   CORE_CONSOLE_TOKEN_URL       VITE_OAUTH_TOKEN_URL
#   CORE_CONSOLE_CLIENT_ID       VITE_OAUTH_CLIENT_ID
#   AUTH_AUDIENCE                VITE_OAUTH_AUDIENCE
#   CORE_CONSOLE_SCOPE           VITE_OAUTH_SCOPE
#
# None of these is a secret: the console is a PUBLIC OAuth client (authorization
# code + PKCE with S256, no client secret).

# Absolute base URL for the core REST API (only for a split-host deploy).
# When unset, config.ts falls back to the same-origin path (/api/v1). In dev the
# maintainerd-dev nginx edge serves the console and proxies /api → core, so this
# stays empty.
VITE_CORE_API_BASE_URL=

# --- identity ---------------------------------------------------------------
# ISSUER_URL, TOKEN_URL and CLIENT_ID are required TOGETHER; a half-configured
# identity is treated as none, because it would otherwise send an operator to an
# authorize endpoint whose code can never be exchanged.
#
# Set NONE of them and the console cannot obtain a token. It will still call the
# API — which is correct while core runs with APP_ENV=development and no
# AUTH_JWKS_URL/AUTH_ISSUER/AUTH_AUDIENCE, because core's guard is then dev-open
# and serves every caller. If core IS enforcing, the first refusal puts the
# console on a screen naming these variables rather than in a redirect loop.

# The maintainerd-auth hosted identity app, e.g. https://identity.auth.maintainerd.local
# Runtime name: AUTH_ISSUER — the same origin core enforces as its issuer.
VITE_OAUTH_ISSUER_URL=

# Absolute URL of the OAuth token endpoint on maintainerd-auth's public API,
# e.g. https://identity-api.auth.maintainerd.local/api/v1/oauth/token
# Runtime name: CORE_CONSOLE_TOKEN_URL.
VITE_OAUTH_TOKEN_URL=

# The console's OAuth client id in maintainerd-auth — the FRONTEND SPA CLIENT an
# operator creates during setup. Public clients only.
# Runtime name: CORE_CONSOLE_CLIENT_ID.
VITE_OAUTH_CLIENT_ID=

# The resource-API audience core enforces (AUTH_AUDIENCE on the service). The
# token has to be minted FOR core, or its verifier rejects it — sign-in succeeds
# and every API call still returns 401.
# Runtime name: AUTH_AUDIENCE.
VITE_OAUTH_AUDIENCE=

# Extra scopes beyond `openid profile email`. The core permissions a user holds
# come from their Auth grants, not from what the console asks for.
# Runtime name: CORE_CONSOLE_SCOPE.
VITE_OAUTH_SCOPE=
